// profile for the Gadi supercomputer at NCI
// More info: https://opus.nci.org.au/display/DAE/Nextflow

// Preset use of containers with Singularity
singularity {
    enabled = true
    cacheDir = "/scratch/${params.gadi_account}/${params.whoami}/singularity"
    autoMounts = true
    autoCleanUp = true
}

process {
	// beforeScript = "${projectDir}/scripts/pullContainers.sh"
	module = 'singularity'
	cache = 'lenient'
	stageInMode = 'symlink'
	project = "${params.gadi_account}"
	storage = params.storage_account ?: "scratch/${params.gadi_account}+gdata/${params.gadi_account}"
	disk = '30.GB'

    withName: 'checkInputs' {
	    executor = 'local'
    }
    withName: 'manta' {
        executor = 'pbspro'
        queue = 'normal'
        cpus = 12
        time = '2h'
        memory = '48.GB'
    }

    withName: 'rehead_manta' {
        executor = 'local'
        }

    withName: 'smoove' {
        executor = 'pbspro'
        queue = 'normal'
	    disk = '50.GB'
        cpus = 4
        memory = '16.GB'
        // walltime scales with read pairs that map to different chr 
        time = { 6.h * task.attempt }
        errorStrategy = { task.exitStatus in [137, 143] ? 'retry' : 'ignore' }
        maxRetries = 1
    }

    withName: 'rehead_smoove' {
        executor = 'local'
    }

    withName: 'tiddit_sv' {
        executor = 'pbspro'
        queue = 'normal'
        cpus = 6
        memory = { 24.GB * task.attempt }
        time = { 2.h * task.attempt }
        errorStrategy = { task.exitStatus in [137, 143] ? 'retry' : 'terminate' }
        maxRetries = 3
    }

    withName: 'rehead_tiddit' {
        executor = 'local'
    }

    withName: 'tiddit_cov' {
        executor = 'pbspro'
        queue = 'normal'
        cpus = 1
        time = '1h'
        memory = '4.GB'
    }

    withName: 'survivor_merge' {
        executor = 'pbspro'
        queue = 'normal'
        cpus = 1
        time = '1h'
        memory = '4.GB'
    }

    withName: 'survivor_summary' {
        executor = 'pbspro'
        queue = 'normal'
        cpus = 1
        time = '1h'
        memory = '4.GB'
    }

    withName: 'annotsv' {
        executor = 'pbspro'
        queue = 'normal'
        cpus = 4
        time = '1h'
        memory = '16.GB'
    }
}
